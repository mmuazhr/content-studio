# Supabase project (source of truth for cs_* tables)
SUPABASE_URL=
SUPABASE_KEY=

# Claude API key for pipeline tasks (claude-sonnet-5)
ANTHROPIC_API_KEY=

# Airflow REST API (dashboard -> Airflow trigger)
AIRFLOW_API_URL=http://localhost:8080
AIRFLOW_API_TOKEN=
# Airflow 2.x /api/v1 basic auth — generated by `airflow standalone`
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=

# 1 = stub all Higgsfield calls, no credit spend (default SAFE). Set to 0 to go live.
DRY_RUN=1
